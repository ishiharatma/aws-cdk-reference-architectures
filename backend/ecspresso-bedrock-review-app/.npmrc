# Supply-chain hardening for `npm install` / `npm ci`.
# min-release-age requires npm >= 11.10.0 and allow-git requires npm >= 11.9.0;
# older npm silently ignores them.

# Fail the install when a package's `engines` does not match the running Node/npm.
engine-strict=true
# Do not run dependency lifecycle scripts (preinstall/install/postinstall).
# `npm run <script>` still runs explicitly requested scripts.
ignore-scripts=true
# Always run the vulnerability audit on install.
audit=true
# Only install versions published more than 1 day ago.
min-release-age=1
# Fail the install on conflicting peerDependencies instead of warning.
strict-peer-deps=true
# Do not fetch or install git dependencies.
allow-git=none
# Save newly added dependencies with an exact version instead of a ^ range.
save-exact=true
