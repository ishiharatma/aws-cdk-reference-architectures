    },
    "ManagementInstanceBootstrapDocument8ED4DADA": {
      "Properties": {
        "Content": {
          "description": "Join the management instance to Managed AD and build OUs, groups, PSO and GPOs",
          "mainSteps": [
            {
              "action": "aws:runPowerShellScript",
              "inputs": {
                "runCommand": [
                  "$ConfigBase64 = '{{ ConfigBase64 }}'",
                  "$DnsIpAddresses = '{{ DnsIpAddresses }}'",
                  "$AdminSecretArn = '{{ AdminSecretArn }}'",
                  "$Region = '{{ Region }}'",
                  "$NetBiosName = 'WSDEV'",
                  "$Stage2Base64 = ''",
                  "# ---------------------------------------------------------------------------",
                  "# Shared helpers for the SSM Run Command documents of this workspace.",
                  "# Expects $AdminSecretArn, $Region and $NetBiosName to be defined by the caller.",
                  "# ---------------------------------------------------------------------------",
                  "$ErrorActionPreference = 'Stop'",
                  "$ProgressPreference = 'SilentlyContinue'",
                  "",
                  "function Get-AdminPassword {",
                  "    # AWS Tools for PowerShell ship with the AWS Windows AMIs; fall back to the AWS CLI.",
                  "    if (Get-Command -Name Get-SECSecretValue -ErrorAction SilentlyContinue) {",
                  "        return (Get-SECSecretValue -SecretId $AdminSecretArn -Region $Region).SecretString",
                  "    }",
                  "    $json = & aws secretsmanager get-secret-value --secret-id $AdminSecretArn --region $Region --output json",
                  "    if ($LASTEXITCODE -ne 0) {",
                  "        throw 'Failed to read the AD admin secret from Secrets Manager'",
                  "    }",
                  "    return ($json | ConvertFrom-Json).SecretString",
                  "}",
                  "",
                  "function Get-AdminCredential {",
                  "    param([Parameter(Mandatory)] [string]$Password)",
                  "    $secure = ConvertTo-SecureString -String $Password -AsPlainText -Force",
                  "    return New-Object System.Management.Automation.PSCredential("$NetBiosName\\Admin", $secure)",
                  "}",
                  "",
                  "# ---------------------------------------------------------------------------",
                  "# Bootstrap of the management instance (runs as LocalSystem via a State Manager association).",
                  "#",
                  "# Phase 1 (not yet domain-joined):",
                  "#   point DNS at the domain controllers, install RSAT / GPMC, create the OU the instance joins",
                  "#   into (OU=Admin) remotely with the admin credential, join the domain and exit 3010 so that",
                  "#   SSM reboots the instance and runs this script again.",
                  "# Phase 2 (domain-joined):",
                  "#   run Build-AdObjects.ps1 as the domain admin through a one-shot scheduled task. The",
                  "#   GroupPolicy cmdlets have no -Credential parameter and LocalSystem (the computer account)",
                  "#   has no rights on GPOs, so the work must run in a real logon session of the admin.",
                  "#",
                  "# Variables injected by the document header:",
                  "#   $ConfigBase64, $DnsIpAddresses, $AdminSecretArn, $Region, $Stage2Base64, $NetBiosName",
                  "# ---------------------------------------------------------------------------",
                  "$Config = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($ConfigBase64)) | ConvertFrom-Json",
                  "$DnsIps = @($DnsIpAddresses.Split(',') | ForEach-Object { $_.Trim() } | Where-Object { $_ })",
                  "$WorkDir = 'C:\\ProgramData\\WorkSpacesAdBootstrap'",
                  "New-Item -ItemType Directory -Path $WorkDir -Force | Out-Null",
                  "",
                  "$password = Get-AdminPassword",
                  "$credential = Get-AdminCredential -Password $password",
                  "",
                  "Install-WindowsFeature -Name RSAT-AD-PowerShell, RSAT-ADDS-Tools, GPMC | Out-Null",
                  "Import-Module ActiveDirectory",
                  "",
                  "$domainDn = ($Config.domainName.Split('.') | ForEach-Object { "DC=$_" }) -join ','",
                  "$baseDn = "OU=$($Config.netBiosName),$domainDn"",
                  "",
                  "if (-not (Get-CimInstance -ClassName Win32_ComputerSystem).PartOfDomain) {",
                  "    # ----------------------------- Phase 1 -----------------------------",
                  "    $adapter = Get-NetAdapter | Where-Object Status -eq 'Up' | Sort-Object ifIndex | Select-Object -First 1",
                  "    Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses $DnsIps",
                  "    Write-Output "DNS servers set to $($DnsIps -join ', ')"",
                  "",
                  "    # Create the join target OU chain first so the computer object lands in OU=Admin directly",
                  "    # (and therefore receives GPO-Admin from its first boot in the domain).",
                  "    $parentDn = $baseDn",
                  "    foreach ($rdn in ($Config.managementComputerOu.Split(',') | ForEach-Object { $_.Trim() })[-1..0]) {",
                  "        $name = $rdn -replace '^OU=', ''",
                  "        $dn = "$rdn,$parentDn"",
                  "        $existing = Get-ADOrganizationalUnit -Filter "DistinguishedName -eq '$dn'" -Server $DnsIps[0] -Credential $credential",
                  "        if (-not $existing) {",
                  "            New-ADOrganizationalUnit -Name $name -Path $parentDn -ProtectedFromAccidentalDeletion $true \`",
                  "                -Server $DnsIps[0] -Credential $credential",
                  "            Write-Output "Created OU $dn"",
                  "        }",
                  "        $parentDn = $dn",
                  "    }",
                  "",
                  "    Add-Computer -DomainName $Config.domainName -Credential $credential -OUPath $parentDn -Force",
                  "    Write-Output "Joined $($Config.domainName) into $parentDn. Rebooting to continue (exit 3010)."",
                  "    exit 3010",
                  "}",
                  "",
                  "# ----------------------------- Phase 2 -----------------------------",
                  "# The admin needs local administrator rights for the scheduled task (batch logon, elevated token).",
                  "try {",
                  "    Add-LocalGroupMember -SID 'S-1-5-32-544' -Member "$($Config.netBiosName)\\Admin" -ErrorAction Stop",
                  "} catch {",
                  "    if ($_.FullyQualifiedErrorId -notmatch 'MemberExists') { throw }",
                  "}",
                  "",
                  "$stage2Path = Join-Path $WorkDir 'Build-AdObjects.ps1'",
                  "$configPath = Join-Path $WorkDir 'config.json'",
                  "$resultPath = Join-Path $WorkDir 'result.txt'",
                  "$logPath = Join-Path $WorkDir 'build-ad-objects.log'",
                  "$stage2 = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($Stage2Base64))",
                  "[IO.File]::WriteAllText($stage2Path, $stage2, (New-Object System.Text.UTF8Encoding $true))",
                  "[IO.File]::WriteAllText($configPath, ($Config | ConvertTo-Json -Depth 10), (New-Object System.Text.UTF8Encoding $false))",
                  "Remove-Item -Path $resultPath -ErrorAction SilentlyContinue",
                  "",
                  "$taskName = 'WorkSpacesAdBootstrap'",
                  "$action = New-ScheduledTaskAction -Execute 'powershell.exe' \`",
                  "    -Argument "-NoProfile -ExecutionPolicy Bypass -File \`"$stage2Path\`" -ConfigPath \`"$configPath\`" -ResultPath \`"$resultPath\`" -LogPath \`"$logPath\`""",
                  "Register-ScheduledTask -TaskName $taskName -Action $action -User "$($Config.netBiosName)\\Admin" \`",
                  "    -Password $password -RunLevel Highest -Force | Out-Null",
                  "try {",
                  "    Start-ScheduledTask -TaskName $taskName",
                  "    $deadline = (Get-Date).AddMinutes(30)",
                  "    while (-not (Test-Path $resultPath) -and (Get-Date) -lt $deadline) {",
                  "        Start-Sleep -Seconds 10",
                  "    }",
                  "} finally {",
                  "    Unregister-ScheduledTask -TaskName $taskName -Confirm:$false",
                  "}",
                  "",
                  "if (Test-Path $logPath) { Get-Content -Path $logPath | Write-Output }",
                  "$result = if (Test-Path $resultPath) { (Get-Content -Path $resultPath -Raw).Trim() } else { 'TIMEOUT' }",
                  "if ($result -ne 'SUCCESS') {",
                  "    throw "Build-AdObjects.ps1 did not succeed: $result"",
                  "}",
                  "",
                  "gpupdate /target:computer /force | Out-Null",
                  "Write-Output 'AD objects and GPOs are in place.'",
                  "",
                ],
                "timeoutSeconds": "3600",
              },
              "name": "Bootstrap",
            },
          ],
          "parameters": {
            "AdminSecretArn": {
              "description": "Secrets Manager ARN of the AD admin password",
              "type": "String",
            },
            "ConfigBase64": {
              "description": "Base64 JSON of the AD design",
              "type": "String",
            },
            "DnsIpAddresses": {
              "description": "Domain controller IPs (comma-separated)",
              "type": "String",
            },
            "Region": {
              "description": "Region of the secret",
              "type": "String",
            },
          },
          "schemaVersion": "2.2",
        },
        "DocumentFormat": "JSON",
        "DocumentType": "Command",
      },
      "Type": "AWS::SSM::Document",
    },
    "ManagementInstanceInstallDcvAdmxDocumentE7B6FF24": {
      "Properties": {
        "Content": {
          "description": "Copy wsp.admx / wsp.adml from a WorkSpace into the Group Policy Central Store",
          "mainSteps": [
            {
              "action": "aws:runPowerShellScript",
              "inputs": {
                "runCommand": [
                  "$WorkSpaceComputerName = '{{ WorkSpaceComputerName }}'",
                  "$DomainName = 'wsdev.example.co.jp'",
                  {
                    "Fn::Join": [
                      "",
                      [
                        "$AdminSecretArn = '",
                        {
                          "Ref": "ManagedAdAdminSecret6ED1FDE9",
                        },
                        "'",
                      ],
                    ],
                  },
                  "$Region = 'ap-northeast-1'",
                  "$NetBiosName = 'WSDEV'",
                  "# ---------------------------------------------------------------------------",
                  "# Shared helpers for the SSM Run Command documents of this workspace.",
                  "# Expects $AdminSecretArn, $Region and $NetBiosName to be defined by the caller.",
                  "# ---------------------------------------------------------------------------",
                  "$ErrorActionPreference = 'Stop'",
                  "$ProgressPreference = 'SilentlyContinue'",
                  "",
                  "function Get-AdminPassword {",
                  "    # AWS Tools for PowerShell ship with the AWS Windows AMIs; fall back to the AWS CLI.",
                  "    if (Get-Command -Name Get-SECSecretValue -ErrorAction SilentlyContinue) {",
                  "        return (Get-SECSecretValue -SecretId $AdminSecretArn -Region $Region).SecretString",
                  "    }",
                  "    $json = & aws secretsmanager get-secret-value --secret-id $AdminSecretArn --region $Region --output json",
                  "    if ($LASTEXITCODE -ne 0) {",
                  "        throw 'Failed to read the AD admin secret from Secrets Manager'",
                  "    }",
                  "    return ($json | ConvertFrom-Json).SecretString",
                  "}",
                  "",
                  "function Get-AdminCredential {",
                  "    param([Parameter(Mandatory)] [string]$Password)",
                  "    $secure = ConvertTo-SecureString -String $Password -AsPlainText -Force",
                  "    return New-Object System.Management.Automation.PSCredential("$NetBiosName\\Admin", $secure)",
                  "}",
                  "",
                  "# ---------------------------------------------------------------------------",
                  "# Copies the DCV Group Policy templates (wsp.admx / wsp.adml) from a running WorkSpace into the",
                  "# domain's Central Store, so the DCV settings of GPO-WS-Security can be edited in GPMC.",
                  "# Run once after the first WorkSpace is AVAILABLE (runs as LocalSystem via Run Command).",
                  "#",
                  "# Reaching the WorkSpace uses WinRM (TCP 5985), which GPO-WS-Audit opens for the management",
                  "# subnets and the WorkSpaces security group allows from them.",
                  "#",
                  "# Variables injected by the document header:",
                  "#   $WorkSpaceComputerName, $DomainName, $AdminSecretArn, $Region, $NetBiosName",
                  "# ---------------------------------------------------------------------------",
                  "$password = Get-AdminPassword",
                  "$credential = Get-AdminCredential -Password $password",
                  "",
                  "$staging = Join-Path $env:ProgramData 'WorkSpacesAdBootstrap\\wsp-admx'",
                  "New-Item -ItemType Directory -Path $staging -Force | Out-Null",
                  "",
                  "$session = New-PSSession -ComputerName $WorkSpaceComputerName -Credential $credential",
                  "try {",
                  "    Copy-Item -FromSession $session -Path 'C:\\Program Files\\Amazon\\WSP\\wsp.admx' -Destination $staging -Force",
                  "    Copy-Item -FromSession $session -Path 'C:\\Program Files\\Amazon\\WSP\\wsp.adml' -Destination $staging -Force",
                  "} finally {",
                  "    Remove-PSSession -Session $session",
                  "}",
                  "",
                  "New-PSDrive -Name WsSysvol -PSProvider FileSystem -Root "\\\\$DomainName\\SYSVOL" -Credential $credential | Out-Null",
                  "try {",
                  "    $central = "WsSysvol:\\$DomainName\\Policies\\PolicyDefinitions"",
                  "    if (-not (Test-Path $central)) {",
                  "        # Once a Central Store exists GPMC reads templates only from it, so seed it with the",
                  "        # templates of this Windows Server 2025 instance first.",
                  "        Copy-Item -Path "$env:windir\\PolicyDefinitions" -Destination "WsSysvol:\\$DomainName\\Policies" -Recurse",
                  "        Write-Output 'Created the Central Store from the local PolicyDefinitions'",
                  "    }",
                  "    New-Item -ItemType Directory -Path "$central\\en-US" -Force | Out-Null",
                  "    Copy-Item -Path (Join-Path $staging 'wsp.admx') -Destination $central -Force",
                  "    Copy-Item -Path (Join-Path $staging 'wsp.adml') -Destination "$central\\en-US" -Force",
                  "    Write-Output "Installed wsp.admx / wsp.adml into $central"",
                  "} finally {",
                  "    Remove-PSDrive -Name WsSysvol",
                  "}",
                  "",
                ],
                "timeoutSeconds": "600",
              },
              "name": "InstallDcvAdmx",
            },
          ],
          "parameters": {
            "WorkSpaceComputerName": {
              "allowedPattern": "^[A-Za-z0-9-]{1,15}$",
              "description": "Computer name of a running WorkSpace (e.g. WSAMZN-XXXXXXXX)",
              "type": "String",
            },
          },
          "schemaVersion": "2.2",
        },
        "DocumentFormat": "JSON",
        "DocumentType": "Command",
      },
      "Type": "AWS::SSM::Document",
    },
    "ManagementInstanceInstanceProfile1FE03A79": {
      "Properties": {
        "Roles": [
          {
            "Ref": "ManagementInstanceRole9A01B5F9",
          },
        ],
      },
      "Type": "AWS::IAM::InstanceProfile",
    },
