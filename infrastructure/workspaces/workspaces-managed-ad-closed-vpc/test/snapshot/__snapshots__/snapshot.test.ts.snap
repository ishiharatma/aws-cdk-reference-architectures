      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Condition": {
                "Bool": {
                  "aws:MultiFactorAuthPresent": "true",
                },
              },
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::123456789012:root",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "WorkSpaces operator: lifecycle / apps / images / ds-data users; no network or directory settings",
        "MaxSessionDuration": 3600,
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": [
                    "workspaces:CreateTags",
                    "workspaces:CreateWorkspaces",
                    "workspaces:RebootWorkspaces",
                    "workspaces:RebuildWorkspaces",
                    "workspaces:StartWorkspaces",
                    "workspaces:StopWorkspaces",
                    "workspaces:TerminateWorkspaces",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "AllowWorkSpacesLifecycle",
                },
                {
                  "Action": [
                    "workspaces:AssociateWorkspaceApplication",
                    "workspaces:DeployWorkspaceApplications",
                    "workspaces:DisassociateWorkspaceApplication",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "AllowLicenseIncludedApplications",
                },
                {
                  "Action": [
                    "workspaces:CreateWorkspaceBundle",
                    "workspaces:CreateWorkspaceImage",
                    "workspaces:UpdateWorkspaceBundle",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "AllowImagesAndBundles",
                },
                {
                  "Action": [
                    "ds:DescribeDirectories",
                    "ec2:DescribeAvailabilityZones",
                    "ec2:DescribeSecurityGroups",
                    "ec2:DescribeSubnets",
                    "ec2:DescribeVpcs",
                    "workspaces:Describe*",
                    "workspaces:List*",
                  ],
                  "Effect": "Allow",
                  "Resource": "*",
                  "Sid": "AllowReadOnly",
                },
                {
                  "Action": [
                    "ds-data:CreateUser",
                    "ds-data:DescribeUser",
                    "ds-data:DisableUser",
                    "ds-data:ListGroupsForMember",
                    "ds-data:ListUsers",
                    "ds-data:SearchUsers",
                    "ds:AccessDSData",
                    "ds:ResetUserPassword",
                  ],
                  "Effect": "Allow",
                  "Resource": {
                    "Fn::Join": [
                      "",
                      [
                        "arn:aws:ds:ap-northeast-1:123456789012:directory/",
                        {
                          "Fn::GetStackOutput": {
                            "OutputName": "PublishOutputRefManagedAdDirectoryDF3AEB514E680207",
                            "Region": "ap-northeast-1",
                            "StackName": "test-test-ws-directory",
                          },
                        },
                      ],
                    ],
                  },
                  "Sid": "AllowDirectoryDataUserManagement",
                },
                {
                  "Action": [
                    "workspaces:AssociateIpGroups",
                    "workspaces:AuthorizeIpRules",
                    "workspaces:CreateIpGroup",
                    "workspaces:DeleteIpGroup",
                    "workspaces:DisassociateIpGroups",
                    "workspaces:RevokeIpRules",
                    "workspaces:UpdateRulesOfIpGroup",
                  ],
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyIpAccessControlGroups",
                },
                {
                  "Action": [
                    "workspaces:DeregisterWorkspaceDirectory",
                    "workspaces:RegisterWorkspaceDirectory",
                  ],
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyDirectoryRegistration",
                },
                {
                  "Action": "workspaces:ModifyWorkspaceAccessProperties",
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyAccessProperties",
                },
                {
                  "Action": "workspaces:ModifyWorkspaceCreationProperties",
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyCreationProperties",
                },
                {
                  "Action": "workspaces:ModifyClientProperties",
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyClientProperties",
                },
                {
                  "Action": "workspaces:ModifySelfservicePermissions",
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenySelfservicePermissions",
                },
                {
                  "Action": [
                    "ec2:AcceptVpcPeeringConnection",
                    "ec2:AssociateRouteTable",
                    "ec2:AuthorizeSecurityGroupEgress",
                    "ec2:AuthorizeSecurityGroupIngress",
                    "ec2:CreateNetworkAcl",
                    "ec2:CreateNetworkAclEntry",
                    "ec2:CreateRoute",
                    "ec2:CreateRouteTable",
                    "ec2:CreateSecurityGroup",
                    "ec2:CreateVpcEndpoint",
                    "ec2:CreateVpcPeeringConnection",
                    "ec2:DeleteNetworkAcl",
                    "ec2:DeleteNetworkAclEntry",
                    "ec2:DeleteRoute",
                    "ec2:DeleteRouteTable",
                    "ec2:DeleteSecurityGroup",
                    "ec2:DeleteVpcEndpoints",
                    "ec2:DeleteVpcPeeringConnection",
                    "ec2:DisassociateRouteTable",
                    "ec2:ModifyNetworkInterfaceAttribute",
                    "ec2:ModifySecurityGroupRules",
                    "ec2:ModifyVpcEndpoint",
                    "ec2:ModifyVpcEndpointServicePermissions",
                    "ec2:ModifyVpcPeeringConnectionOptions",
                    "ec2:ReplaceNetworkAclAssociation",
                    "ec2:ReplaceNetworkAclEntry",
                    "ec2:ReplaceRoute",
                    "ec2:ReplaceRouteTableAssociation",
                    "ec2:RevokeSecurityGroupEgress",
                    "ec2:RevokeSecurityGroupIngress",
                    "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
                    "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
                  ],
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyNetworkPath",
                },
                {
                  "Action": [
                    "ds:Accept*",
                    "ds:Add*",
                    "ds:AuthorizeApplication",
                    "ds:Cancel*",
                    "ds:Create*",
                    "ds:Delete*",
                    "ds:Deregister*",
                    "ds:Disable*",
                    "ds:Enable*",
                    "ds:Register*",
                    "ds:Reject*",
                    "ds:Remove*",
                    "ds:ResetDirectory*",
                    "ds:Restore*",
                    "ds:Share*",
                    "ds:Start*",
                    "ds:UnauthorizeApplication",
                    "ds:Unshare*",
                    "ds:Update*",
                    "ds:Verify*",
                  ],
                  "Effect": "Deny",
                  "Resource": "*",
                  "Sid": "DenyDirectorySettings",
                },
              ],
              "Version": "2012-10-17",
            },
            "PolicyName": "WorkSpacesOperator",
          },
        ],
        "RoleName": "test-workspaces-operator",
      },
      "Type": "AWS::IAM::Role",
    },
