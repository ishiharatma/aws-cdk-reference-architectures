        "AlbControllerServiceAccountmanifestServiceAccountServiceAccountResource5B49E918",
        "AlbControllerServiceAccountRoleDefaultPolicy1DF8FD2E",
        "AlbControllerServiceAccountRoleD9C4ED3F",
        "ClusterKubectlReadyBarrier200052AF",
      ],
      "Properties": {
        "ClusterName": {
          "Ref": "ClusterEB0386A7",
        },
        "Manifest": "[{"apiVersion":"v1","kind":"Namespace","metadata":{"name":"web","labels":{"aws.cdk.eks/prune-c82a9fdd91da96a4f17001711b715f1d7acea2785e":""}}},{"apiVersion":"apps/v1","kind":"Deployment","metadata":{"name":"web","namespace":"web","labels":{"aws.cdk.eks/prune-c82a9fdd91da96a4f17001711b715f1d7acea2785e":"","app.kubernetes.io/name":"web"}},"spec":{"replicas":3,"selector":{"matchLabels":{"app.kubernetes.io/name":"web"}},"template":{"metadata":{"labels":{"app.kubernetes.io/name":"web"}},"spec":{"terminationGracePeriodSeconds":30,"topologySpreadConstraints":[{"maxSkew":1,"topologyKey":"topology.kubernetes.io/zone","whenUnsatisfiable":"DoNotSchedule","labelSelector":{"matchLabels":{"app.kubernetes.io/name":"web"}}}],"securityContext":{"runAsNonRoot":true,"runAsUser":65534,"seccompProfile":{"type":"RuntimeDefault"}},"containers":[{"name":"web","image":"public.ecr.aws/docker/library/python:3.13-alpine","command":["python","-c","\\"\\"\\"Small HTTP service that reports which pod, node and AZ answered and drains on SIGTERM.\\n\\nPassed to \`python -c\` by the Deployment manifest, so it uses the standard library only.\\nThe pod and node identity come from the Downward API (see lib/constructs/web-app.ts).\\n\\"\\"\\"\\nimport json\\nimport os\\nimport signal\\nimport threading\\nimport time\\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\\n\\nPORT = int(os.environ.get(\\"PORT\\", \\"8080\\"))\\nDRAIN_SECONDS = int(os.environ.get(\\"DRAIN_SECONDS\\", \\"10\\"))\\nSTARTED_AT = time.time()\\ndraining = threading.Event()\\n\\nMETA = {\\n    \\"cluster\\": os.environ.get(\\"CLUSTER_MODE\\", \\"unknown\\"),\\n    \\"pod\\": os.environ.get(\\"POD_NAME\\", \\"local\\"),\\n    \\"node\\": os.environ.get(\\"NODE_NAME\\", \\"local\\"),\\n    # Empty when the API server does not copy the node topology labels onto the pod.\\n    \\"az\\": os.environ.get(\\"ZONE\\") or \\"unknown\\",\\n}\\n\\n\\ndef log(event, **fields):\\n    print(json.dumps({\\"event\\": event, \\"ts\\": round(time.time(), 3), **fields}), flush=True)\\n\\n\\nclass Handler(BaseHTTPRequestHandler):\\n    def _send(self, status, body):\\n        payload = json.dumps(body).encode()\\n        self.send_response(status)\\n        self.send_header(\\"Content-Type\\", \\"application/json\\")\\n        self.send_header(\\"Content-Length\\", str(len(payload)))\\n        self.end_headers()\\n        self.wfile.write(payload)\\n\\n    def do_GET(self):\\n        if self.path == \\"/health\\":\\n            # 503 while draining so the ALB stops sending new requests to this pod.\\n            self._send(503 if draining.is_set() else 200, {\\"draining\\": draining.is_set()})\\n            return\\n        self._send(200, {**META, \\"draining\\": draining.is_set(), \\"uptime\\": round(time.time() - STARTED_AT)})\\n\\n    def log_message(self, *args):\\n        pass\\n\\n\\ndef on_sigterm(signum, frame):\\n    # Sent by a rollout, scale-in, node drain or node replacement.\\n    log(\\"SIGTERM\\", drainSeconds=DRAIN_SECONDS, **META)\\n    draining.set()\\n\\n    def stop():\\n        time.sleep(DRAIN_SECONDS)\\n        log(\\"EXIT\\", **META)\\n        os._exit(0)\\n\\n    threading.Thread(target=stop, daemon=True).start()\\n\\n\\nsignal.signal(signal.SIGTERM, on_sigterm)\\nserver = ThreadingHTTPServer((\\"0.0.0.0\\", PORT), Handler)\\nlog(\\"START\\", port=PORT, **META)\\nthreading.Thread(target=server.serve_forever, daemon=True).start()\\nwhile True:\\n    time.sleep(3600)\\n"],"ports":[{"containerPort":8080}],"env":[{"name":"PORT","value":"8080"},{"name":"DRAIN_SECONDS","value":"10"},{"name":"CLUSTER_MODE","value":"managed-node-group"},{"name":"POD_NAME","valueFrom":{"fieldRef":{"fieldPath":"metadata.name"}}},{"name":"NODE_NAME","valueFrom":{"fieldRef":{"fieldPath":"spec.nodeName"}}},{"name":"ZONE","valueFrom":{"fieldRef":{"fieldPath":"metadata.labels['topology.kubernetes.io/zone']"}}}],"resources":{"requests":{"cpu":"100m","memory":"64Mi"},"limits":{"memory":"128Mi"}},"readinessProbe":{"httpGet":{"path":"/health","port":8080},"periodSeconds":5},"securityContext":{"allowPrivilegeEscalation":false,"readOnlyRootFilesystem":true,"capabilities":{"drop":["ALL"]}}}]}}}},{"apiVersion":"v1","kind":"Service","metadata":{"name":"web","namespace":"web","labels":{"aws.cdk.eks/prune-c82a9fdd91da96a4f17001711b715f1d7acea2785e":"","app.kubernetes.io/name":"web"}},"spec":{"type":"ClusterIP","selector":{"app.kubernetes.io/name":"web"},"ports":[{"port":80,"targetPort":8080,"protocol":"TCP"}]}}]",
        "PruneLabel": "aws.cdk.eks/prune-c82a9fdd91da96a4f17001711b715f1d7acea2785e",
        "ServiceToken": {
