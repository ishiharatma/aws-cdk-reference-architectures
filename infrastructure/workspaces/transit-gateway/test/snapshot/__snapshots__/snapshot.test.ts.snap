        "SecurityGroupEgress": [
          {
            "CidrIp": "0.0.0.0/0",
            "Description": "Allow all outbound traffic by default",
            "IpProtocol": "-1",
          },
        ],
        "SecurityGroupIngress": [
          {
            "CidrIp": "10.0.0.0/8",
            "Description": "Allow ICMP from Transit Gateway connected networks",
            "FromPort": -1,
            "IpProtocol": "icmp",
            "ToPort": -1,
          },
          {
            "CidrIp": "10.0.0.0/8",
            "Description": "Allow SSH from Transit Gateway connected networks",
            "FromPort": 22,
            "IpProtocol": "tcp",
            "ToPort": 22,
          },
          {
            "CidrIp": "192.0.2.10/32",
            "Description": "Allow SSH from operator IP 192.0.2.10/32",
            "FromPort": 22,
            "IpProtocol": "tcp",
            "ToPort": 22,
