exports[`Stack Snapshot Tests CrossAccountRoleStack CloudFormation template snapshot 1`] = `
{
  "Outputs": {
    "CrossAccountDeployRoleArn": {
      "Description": "IAM role the dev account's stg Deploy CodeBuild project assumes to deploy here",
      "Value": {
        "Fn::GetAtt": [
          "CrossAccountDeployRole61168D2E",
          "Arn",
        ],
      },
    },
  },
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>",
    },
  },
  "Resources": {
    "CrossAccountDeployRole61168D2E": {
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-IAM5",
              "reason": "s3:ListAllMyBuckets does not support resource-level scoping; this is a sample deploy role meant to be replaced with real, resource-scoped deployment permissions.",
            },
          ],
        },
      },
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::111111111111:role/testproject-stg-deploy-build-role",
              },
            },
          ],
          "Version": "2012-10-17",
        },
        "Description": "Assumed by the testproject CI/CD pipeline's Deploy CodeBuild project (account 111111111111) to deploy into the stg account",
        "MaxSessionDuration": 3600,
        "RoleName": "testproject-stg-cross-account-deploy-role",
      },
      "Type": "AWS::IAM::Role",
    },
    "CrossAccountDeployRoleDefaultPolicyAAA9C26F": {
      "Metadata": {
        "cdk_nag": {
          "rules_to_suppress": [
            {
              "id": "AwsSolutions-IAM5",
              "reason": "s3:ListAllMyBuckets does not support resource-level scoping; this is a sample deploy role meant to be replaced with real, resource-scoped deployment permissions.",
            },
          ],
        },
      },
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:ListAllMyBuckets",
              "Effect": "Allow",
              "Resource": "*",
              "Sid": "AllowSampleReadOnly",
            },
          ],
          "Version": "2012-10-17",
        },
        "PolicyName": "CrossAccountDeployRoleDefaultPolicyAAA9C26F",
        "Roles": [
          {
            "Ref": "CrossAccountDeployRole61168D2E",
          },
        ],
      },
      "Type": "AWS::IAM::Policy",
    },
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5",
                  ],
                  {
                    "Ref": "BootstrapVersion",
                  },
                ],
              },
            ],
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI.",
        },
      ],
    },
  },
}
`;

