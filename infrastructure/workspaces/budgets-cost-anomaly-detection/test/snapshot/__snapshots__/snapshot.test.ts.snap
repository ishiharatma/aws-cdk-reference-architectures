            "Fn::GetAtt": [
              "SchedulerRoleForTarget2f5474F958C018",
              "Arn",
            ],
          },
        },
      },
      "Type": "AWS::Scheduler::Schedule",
    },
    "CostDigestStateMachine86404ADA": {
      "DeletionPolicy": "Delete",
      "DependsOn": [
        "CostDigestStateMachineRoleDefaultPolicy00E5533C",
        "CostDigestStateMachineRole1251210A",
      ],
      "Properties": {
        "DefinitionString": {
          "Fn::Join": [
            "",
            [
              "{"StartAt":"GetCostAndUsage","States":{"GetCostAndUsage":{"Next":"PublishCostDigest","Type":"Task","Resource":"arn:aws:states:::aws-sdk:costexplorer:getCostAndUsage","Arguments":{"Granularity":"MONTHLY","Metrics":["UnblendedCost"],"TimePeriod":{"Start":"{% ($millis() - 86400000 * 7) ~> $fromMillis('[Y0001]-[M01]-[D01]') %}","End":"{% $millis() ~> $fromMillis('[Y0001]-[M01]-[D01]') %}"},"GroupBy":[{"Key":"SERVICE","Type":"DIMENSION"}],"Filter":{"Not":{"Dimensions":{"Key":"SERVICE","Values":["Tax"]}}}},"Assign":{"AngryThreshold":10,"AccountId":"",
              {
                "Ref": "AWS::AccountId",
              },
              "","Project":"TestProject","Environment":"test"},"Output":{"Start":"{% $states.result.ResultsByTime[0].TimePeriod.Start %}","End":"{% $states.result.ResultsByTime[0].TimePeriod.End %}","CostSum":"{% $states.result.ResultsByTime[].Groups[].Metrics.UnblendedCost.Amount.$number() ~> $sum() ~> $round(1) %}","CostSorted":"{% ($all_entries := $map($zip($states.result.ResultsByTime[].Groups[].Keys[0],$states.result.ResultsByTime[].Groups[].Metrics.UnblendedCost.Amount.$number()),function($v) { {\\"Service\\": $v[0], \\"Amount\\": $v[1]} });$services := $all_entries.Service ~> $distinct();$cost_per_service := $map($services,function($s){{\\"Service\\": $s, \\"Total\\": $all_entries[Service=$s].Amount ~> $sum() ~> $round(1)}});$sort($cost_per_service, function($l, $r){ $l.Total < $r.Total });) %}"}},"PublishCostDigest":{"End":true,"Type":"Task","Resource":"arn:aws:states:::sns:publish","Arguments":{"Message":{"version":"1.0","source":"custom","content":{"textType":"client-markdown","title":"{% $states.input.CostSum > $AngryThreshold ? \\"😱 Costs are spiking\\" : \\"😊 Costs are steady\\" %}","description":"{% \\"AWS Account ID: \\" & $AccountId & \\" (\\" & $Project & \\"/\\" & $Environment & \\")\\" & \\"\\\\n\\" & ( $states.input.CostSum > $AngryThreshold ? \\"🚨\\" : \\"✅\\" ) & \\"Cost over the last 7 days: \\" & $string($states.input.CostSum) & \\" USD.\\" & \\"\\\\n\\" & \\"👁‍🗨 7-day threshold: \\" & $AngryThreshold & \\" USD\\" & \\"📅 Period: \\" & $states.input.Start & \\" to \\" & $states.input.End & \\"\\\\n\\" & \\"💸 Top 5 services by cost\\" & \\"\\\\n\\" & \\"\\\\n:one: \\" & ( $states.input.CostSorted[0].Service ~> $replace(/^(AWS|Amazon)\\\\s*/, \\"\\") ) & \\": \\" & $states.input.CostSorted[0].Total & \\" USD\\" & \\"\\\\n:two: \\" & ( $states.input.CostSorted[1].Service ~> $replace(/^(AWS|Amazon)\\\\s*/, \\"\\") ) & \\": \\" & $states.input.CostSorted[1].Total & \\" USD\\" & \\"\\\\n:three: \\" & ( $states.input.CostSorted[2].Service ~> $replace(/^(AWS|Amazon)\\\\s*/, \\"\\") ) & \\": \\" & $states.input.CostSorted[2].Total & \\" USD\\" & \\"\\\\n:four: \\" & ( $states.input.CostSorted[3].Service ~> $replace(/^(AWS|Amazon)\\\\s*/, \\"\\") ) & \\": \\" & $states.input.CostSorted[3].Total & \\" USD\\" & \\"\\\\n:five: \\" & ( $states.input.CostSorted[4].Service ~> $replace(/^(AWS|Amazon)\\\\s*/, \\"\\") ) & \\": \\" & $states.input.CostSorted[4].Total & \\" USD\\" & \\"\\\\n\\" & \\"* Note: cost data has a reporting lag and may not reflect the most recent charges.\\" %}"}},"TopicArn":"",
              {
                "Ref": "CostDigestTopic5AAB33D8",
              },
              ""}}},"QueryLanguage":"JSONata"}",
            ],
          ],
