          "UserData": {
            "Fn::Base64": "#!/bin/bash
set -euxo pipefail
dnf install -y git tar gzip
curl -fsSL https://github.com/coder/code-server/releases/download/v4.141.0/code-server-4.141.0-linux-arm64.tar.gz -o /tmp/code-server.tgz
mkdir -p /opt/code-server && tar -xzf /tmp/code-server.tgz -C /opt/code-server --strip-components=1
ln -sf /opt/code-server/bin/code-server /usr/local/bin/code-server
install -d -o ec2-user -g ec2-user /home/ec2-user/project
git config --system 'credential.https://git-codecommit.*.amazonaws.com.helper' '!aws codecommit credential-helper $@'
git config --system 'credential.https://git-codecommit.*.amazonaws.com.useHttpPath' true
TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
GIT_EMAIL=$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/tags/instance/GitEmail || true)
if [ -n "$GIT_EMAIL" ]; then git config --system user.email "$GIT_EMAIL"; git config --system user.name "\${GIT_EMAIL%%@*}"; fi
dnf install -y nodejs22 nodejs22-npm
npm install -g @anthropic-ai/claude-code
sudo -u ec2-user HOME=/home/ec2-user /usr/local/bin/code-server --install-extension Anthropic.claude-code
install -d -o ec2-user -g ec2-user /home/ec2-user/.claude
cat > /home/ec2-user/.claude/settings.json <<'JSON'
{
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "AWS_REGION": "ap-northeast-1",
    "ANTHROPIC_MODEL": "jp.anthropic.claude-sonnet-4-6",
    "ANTHROPIC_SMALL_FAST_MODEL": "jp.anthropic.claude-haiku-4-5-20251001-v1:0"
  }
}
JSON
chown ec2-user:ec2-user /home/ec2-user/.claude/settings.json
cat > /etc/systemd/system/code-server.service <<'UNIT'
[Unit]
Description=code-server
After=network-online.target
[Service]
User=ec2-user
Environment=HOME=/home/ec2-user
ExecStart=/usr/local/bin/code-server --bind-addr 127.0.0.1:8080 --auth none --disable-telemetry --disable-update-check /home/ec2-user/project
Restart=always
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload && systemctl enable --now code-server",
