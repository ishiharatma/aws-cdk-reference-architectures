    "OnPremDnsForwarder6477B011": {
      "DependsOn": [
        "OnPremDnsForwarderInstanceRoleBEF6C6DA",
      ],
      "Properties": {
        "AvailabilityZone": "dummy1a",
        "BlockDeviceMappings": [
          {
