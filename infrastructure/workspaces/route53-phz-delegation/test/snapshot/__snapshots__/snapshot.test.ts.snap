              "VolumeType": "gp3",
            },
          },
        ],
        "IamInstanceProfile": {
          "Ref": "OnPremDnsForwarderInstanceProfile221C56A4",
        },
        "ImageId": {
          "Ref": "SsmParameterValueawsserviceamiamazonlinuxlatestal2023amikernel61arm64C96584B6F00A464EAD1953AFF4B05118Parameter",
        },
        "InstanceType": "t4g.nano",
        "KeyName": {
          "Ref": "OnPremDnsForwarderKeyPair5970DF1A",
        },
        "LaunchTemplate": {
          "LaunchTemplateName": "ResourceLaunchTemplate",
          "Version": {
            "Fn::GetAtt": [
              "OnPremDnsForwarderLaunchTemplate476A8006",
              "LatestVersionNumber",
            ],
          },
        },
        "SecurityGroupIds": [
          {
            "Fn::GetAtt": [
              "OnPremDnsForwarderSecurityGroup809AD6F2",
              "GroupId",
            ],
          },
          {
            "Fn::GetAtt": [
              "OnPremDnsServerSecurityGroup238F462F",
              "GroupId",
            ],
          },
        ],
        "SubnetId": {
          "Ref": "OnPremVpcPrivateSubnet1Subnet92EEF1E9",
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": "test",
          },
          {
            "Key": "ManagedBy",
            "Value": "CDK",
          },
          {
            "Key": "Name",
            "Value": "OnPremDnsForwarder/test/instance",
          },
          {
            "Key": "Project",
            "Value": "route53-phz-delegation-example",
          },
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash
echo "Test EC2 Instance" > /etc/update-motd.d/00-test-instance
dnf install -y bind bind-utils
cat > /etc/named.conf << 'NAMEDCONFEOF'
options {
    listen-on port 53 { any; };
    listen-on-v6 port 53 { none; };
    directory "/var/named";
    allow-query { 10.0.0.0/8; 127.0.0.1; };
    recursion yes;
    dnssec-validation no;
};
zone "system.example.com" IN {
    type forward;
    forward only;
    forwarders {
        10.0.2.10;
        10.0.2.42;
    };
};
NAMEDCONFEOF
named-checkconf
systemctl enable named
systemctl restart named",
        },
      },
      "Type": "AWS::EC2::Instance",
    },
