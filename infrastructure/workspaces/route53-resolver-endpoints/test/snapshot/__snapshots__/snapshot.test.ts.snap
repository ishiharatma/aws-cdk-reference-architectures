        "UserData": {
          "Fn::Base64": "#!/bin/bash
echo "Test EC2 Instance" > /etc/update-motd.d/00-test-instance
dnf install -y bind bind-utils
TOKEN=$(curl -s -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")
PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/local-ipv4)
cat > /etc/named.conf << 'NAMEDCONFEOF'
options {
    listen-on port 53 { any; };
    listen-on-v6 port 53 { none; };
    directory "/var/named";
    allow-query { 10.0.0.0/8; 127.0.0.1; };
    recursion yes;
    dnssec-validation no;
};
zone "onprem.example.com" IN {
    type master;
    file "/var/named/onprem.example.com.zone";
    allow-update { none; };
};
NAMEDCONFEOF
cat > /var/named/onprem.example.com.zone << ZONEEOF
$TTL 300
@ IN SOA ns.onprem.example.com. admin.onprem.example.com. ( 1 3600 900 604800 300 )
@ IN NS ns.onprem.example.com.
ns.onprem.example.com. IN A \${PRIVATE_IP}
host1.onprem.example.com. IN A \${PRIVATE_IP}
ZONEEOF
chown named:named /var/named/onprem.example.com.zone
chmod 640 /var/named/onprem.example.com.zone
named-checkconf
named-checkzone onprem.example.com /var/named/onprem.example.com.zone
systemctl enable named
systemctl restart named",
        },
