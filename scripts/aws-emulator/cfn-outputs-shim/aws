#!/usr/bin/env bash
# Test-harness shim for stacks deployed with cdkd, which creates no CloudFormation stack.
# Put this directory first on PATH and set CDKD_OUTPUTS to the file written by
# `cdkd deploy -O <file>`: `aws cloudformation describe-stacks` output queries are answered from
# that file, and every other call goes to the real AWS CLI unchanged.
#
# Supported --query forms (the ones the repo's test scripts use):
#   Stacks[0].Outputs[?ends_with(OutputKey, 'Name')].OutputValue | [0]
#   Stacks[0].Outputs[?OutputKey==`Name`].OutputValue

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_AWS="$(PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$SELF_DIR" | paste -sd:)" command -v aws)"

if [[ " $* " == *" cloudformation describe-stacks "* && -n "${CDKD_OUTPUTS:-}" ]]; then
  stack=""
  query=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --stack-name) stack=$2; shift 2 ;;
      --query) query=$2; shift 2 ;;
      *) shift ;;
    esac
  done
  key=$(sed -nE "s/.*(ends_with\(OutputKey, *'|OutputKey==\`)([A-Za-z0-9]+).*/\2/p" <<<"$query")
  jq -r --arg s "$stack" --arg k "$key" \
    '.[$s] // {} | to_entries | map(select(.key | endswith($k))) | (.[0].value // "None")' "$CDKD_OUTPUTS"
  exit 0
fi

exec "$REAL_AWS" "$@"
