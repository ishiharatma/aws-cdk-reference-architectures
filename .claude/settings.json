{
  "extraKnownMarketplaces": {
    "agent-skills-private": {
      "source": {
        "source": "github",
        "repo": "ishiharatma/agent-skills-private"
      }
    },
    "agent-toolkit-for-aws": {
      "source": {
        "source": "github",
        "repo": "aws/agent-toolkit-for-aws"
      }
    }
  },
  "enabledPlugins": {
    "cdk-testing@agent-skills-private": true,
    "cdk-ts-dev-guide@agent-skills-private": true,
    "cdk-spec-writing@agent-skills-private": true,
    "codecommit-pr@agent-skills-private": true,
    "cicd-buildspec@agent-skills-private": true,
    "metrics-reporter@agent-skills-private": true,
    "metrics-logger@agent-skills-private": true,
    "article-writer@agent-skills-private": true,
    "article-proofreader@agent-skills-private": true,
    "aws-mcp@agent-skills-private": true,
    "aws-icon-diagram@agent-skills-private": true,
    "claudeception@agent-skills-private": true,
    "show-me@agent-skills-private": true,
    "cdk-configuration-wiring-review@agent-skills-private": true,
    "cloudformation-deploy-constraint-review@agent-skills-private": true,
    "iac-secret-boundary@agent-skills-private": true,
    "nag-suppression-review@agent-skills-private": true,
    "spec-readability-review@agent-skills-private": true,
    "aws-core@agent-toolkit-for-aws": true
  },
  "permissions": {
    "allow": [
      "Bash(python3 -c ' *)",
      "Read(//tmp/**)",
      "Bash(npm --version)",
      "Bash(npm pkg *)",
      "Bash(npx cdk synth)",
      "Bash(aws sts *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-outbound.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
