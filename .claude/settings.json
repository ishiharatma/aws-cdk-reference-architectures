{
  "extraKnownMarketplaces": {
    "agent-skills-private": {
      "source": {
        "source": "url",
        "url": "git@github.com:ishiharatma/agent-skills-private.git"
      }
    }
  },
  "enabledPlugins": [
    { "marketplace": "agent-skills-private", "plugin": "cdk-testing" },
    { "marketplace": "agent-skills-private", "plugin": "cdk-ts-dev-guide" },
    { "marketplace": "agent-skills-private", "plugin": "cdk-spec-writing" },
    { "marketplace": "agent-skills-private", "plugin": "codecommit-pr" },
    { "marketplace": "agent-skills-private", "plugin": "cicd-buildspec" },
    { "marketplace": "agent-skills-private", "plugin": "article-writer" },
    { "marketplace": "agent-skills-private", "plugin": "article-proofreader" },
    { "marketplace": "agent-skills-private", "plugin": "aws-mcp" },
    { "marketplace": "agent-skills-private", "plugin": "aws-icon-diagram" },
    { "marketplace": "claude-plugins-official", "plugin": "skill-creator" }
  ],
  "permissions": {
    "allow": [
      "Bash(python3 -c ' *)",
      "Read(//tmp/**)",
      "Bash(npm --version)",
      "Bash(npm pkg *)",
      "Bash(npx cdk synth)",
      "Bash(aws sts *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-outbound.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
